# ⚠️ Todas estas variables quedan EMBEBIDAS en el bundle JavaScript público.
# Úsalas sólo para instancias personales/locales, nunca en un deploy público.

# Login local (no es seguridad real: se valida en el navegador)
VITE_ADMIN_USER=admin
VITE_ADMIN_PASSWORD=cambia-esto

# API keys (opcionales: también se pueden cargar desde Ajustes)
VITE_GROQ_API_KEY=
VITE_OPENROUTER_API_KEY=
VITE_OPENAI_API_KEY=
VITE_CEREBRAS_API_KEY=
VITE_GEMINI_API_KEY=
VITE_XAI_API_KEY=

# Proveedores OpenAI-compatibles
VITE_CUSTOM1_NAME=
VITE_CUSTOM1_API_KEY=
VITE_CUSTOM1_API_URL=
VITE_CUSTOM1_MODEL=
VITE_CUSTOM2_NAME=
VITE_CUSTOM2_API_KEY=
VITE_CUSTOM2_API_URL=
VITE_CUSTOM2_MODEL=

# Registro de servidores MCP mostrado en Ajustes
VITE_MCP_REGISTRY_URL=

# ---------------------------------------------------------------------------
# Variables del SERVIDOR (funciones /api en Vercel). Sin prefijo VITE_:
# NO se incluyen en el bundle público. En Vercel: Settings → Environment Variables.
# ---------------------------------------------------------------------------

# Hosts a los que /api/mcp puede reenviar (coma separada, admite *.dominio)
MCP_PROXY_ALLOWED_HOSTS=*.n8n.cloud

# Recomendado: secreto compartido. Si lo defines, cárgalo también en Ajustes → MCP → "Token del proxy".
# Protege /api/mcp y /api/chatgpt de uso por terceros.
NODEMAT_PROXY_TOKEN=

# Sólo desarrollo: permitir destinos http:// en el proxy
# MCP_PROXY_ALLOW_HTTP=1
